Table allowed_usernames {
  id bigint(20) [PK]
  username varchar(255) [unique]
  claimed boolean
  role varchar(255)
}

Table users {
  id bigint
  username varchar [unique]
  firstname varchar
  lastname varchar
  phonenumber varchar(20)
  addressline varchar
  postalcode varchar
  city varchar
  password varchar
  api_token varchar(80)
  role enum('trainee', 'trainer', 'admin' )
}

